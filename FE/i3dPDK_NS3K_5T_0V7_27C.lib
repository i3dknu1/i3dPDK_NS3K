  cell(SDFF_X1) { 
    area : 0.14784 ; 
    cell_leakage_power : 36041.2 ; 
    pin_opposite("QN", "Q");
    rail_connection(VDD, RAIL_VDD);
    rail_connection(VSS, RAIL_VSS);

    leakage_power() { 
      when : "!CK & !D & !SE & !SI & !Q & QN" ; 
