    ff("IQ" , "IQN") { 
      next_state : "((SE * SI) + (D * !SE))" ; 
      clocked_on : "CK" ; 
    }

    pin(D) { 
      direction : input ; 
      nextstate_type : data ; 
      capacitance : 0.9052 ; 
      driver_waveform_rise : "driver_waveform_default_rise" ; 
      driver_waveform_fall : "driver_waveform_default_fall" ; 
      fall_capacitance : 0.9052 ; 
      fall_capacitance_range(0.6364, 0.9052);
      input_signal_level : RAIL_VDD ; 
      rise_capacitance : 0.899 ; 
      rise_capacitance_range(0.5997, 0.899);

      timing() { 
        related_pin : "CK" ; 
        timing_type : hold_rising ; 
        when : "!SE" ; 
        sdf_cond : "NEG_SE === 1'b1" ; 

        fall_constraint(hold_template_3x3) { 
          index_1("0.001174, 0.04493, 0.1985");
          index_2("0.001174, 0.04493, 0.1985");
          values("-0.00364536, -0.000000000525096, 0.0159488",\
                 "-0.00482688, 0, 0.018048",\
                 "-0.00448632, 0.0000000032768, 0.0127117");
        }

        rise_constraint(hold_template_3x3) { 
          index_1("0.001174, 0.04493, 0.1985");
          index_2("0.001174, 0.04493, 0.1985");
          values("0, 0.00858112, 0.0398848",\
                 "-0.00482688, 0, 0.0270848",\
                 "-0.0179496, -0.010152, 0.0127117");
        }
      }

      timing() { 
        related_pin : "CK" ; 
        timing_type : setup_rising ; 
        when : "!SE" ; 
        sdf_cond : "NEG_SE === 1'b1" ; 

        fall_constraint(setup_template_3x3) { 
          index_1("0.001174, 0.04493, 0.1985");
          index_2("0.001174, 0.04493, 0.1985");
          values("0.0129664, 0.00858112, -0.00448632",\
